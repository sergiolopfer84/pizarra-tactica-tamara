rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =====================================================================
       QUIÉN PUEDE ENTRAR EN UNA PIZARRA
       ---------------------------------------------------------------------
       Hasta aquí el acceso era "quien sepa la clave entra": el ID del
       documento es el hash de la clave y con eso bastaba. Eso quiere decir
       que una clave adivinada o filtrada daba acceso completo, sin cuenta y
       sin rastro.

       Ahora una pizarra puede tener DUEÑO:

         · sin `owner`  -> heredada. Sigue funcionando solo con la clave,
                           exactamente igual que antes. Es lo que impide dejar
                           tirado a quien lleva media temporada usando la suya
                           y todavía no se ha registrado.
         · con `owner`  -> cerrada. Solo entran su dueño y los invitados que
                           él haya añadido a `miembros`.

       Reclamar una pizarra = ponerle `owner` a una que no lo tiene, y solo a
       favor de uno mismo. Una vez puesto no se puede cambiar: ni el dueño
       puede cedérsela a otro por accidente, ni un invitado puede quedársela.

       Queda un agujero conocido y es inevitable mientras haya periodo de
       gracia: quien tenga la clave de una pizarra AÚN SIN RECLAMAR puede
       reclamarla él. Se cierra reclamándolas, no con reglas.
       ===================================================================== */

    // null si no tiene dueño. `rec` puede ser resource (lo que hay guardado) o
    // request.resource (lo que se intenta guardar).
    function duenio(rec)   { return rec == null ? null : rec.data.get('owner', null); }
    // Los invitados van por CORREO en minúsculas, no por uid. Guardarlos por uid
    // obligaba a un índice aparte que tradujera correo -> uid, porque desde el
    // navegador no hay forma de preguntarlo; y ese índice dejaba comprobar a
    // cualquiera si un correo tiene cuenta. Con el correo del propio token no
    // hace falta índice, no hay fuga, y se puede invitar a alguien ANTES de que
    // se registre: entrará en cuanto cree su cuenta con ese correo.
    function invitados(rec){ return rec == null ? [] : rec.data.get('miembros', []); }
    function heredada(rec) { return duenio(rec) == null; }

    // El correo del token solo vale si está verificado: sin esa comprobación
    // cualquiera se daría de alta poniendo el correo de otro y entraría en sus
    // pizarras sin haberlo confirmado nunca.
    function correoFiable() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && request.auth.token.email != null;
    }

    function autorizado(rec) {
      return heredada(rec)
             || (request.auth != null
                 && (duenio(rec) == request.auth.uid
                     || (correoFiable()
                         && request.auth.token.email.lower() in invitados(rec))));
    }

    // La pizarra padre, para las reglas de las subcolecciones. Cuesta UNA
    // lectura por petición: las llamadas idénticas dentro de la misma petición
    // se cachean, así que el lote de 400 borrados de limpiarEventos() la paga
    // una sola vez y no 400.
    function pizarra(boardId) {
      return get(/databases/$(database)/documents/pizarras/$(boardId));
    }
    function autorizadoEn(boardId) {
      return !exists(/databases/$(database)/documents/pizarras/$(boardId))
             || autorizado(pizarra(boardId));
    }

    /* ===== Cuenta de usuario =====
       Una cuenta es una LISTA de claves de acceso:
         usuarios/{uid} = { pizarras: [ {clave, nombre, creada} ] } */
    match /usuarios/{uid} {
      // Cada uno ve y borra lo suyo y nada más. Sin `list`: la colección entera
      // no se puede pedir ni estando identificado.
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow list: if false;

      /* El tope de 3 y el correo confirmado se comprueban AQUÍ, no solo en la
         interfaz: los botones se pueden saltar desde la consola del navegador,
         estas reglas no.

         email_verified va en el token, así que va con un retraso de hasta una
         hora respecto a la realidad: quien pulse el enlace del correo seguirá
         sin poder guardar hasta que su sesión pida un token nuevo. Por eso la
         pantalla tiene un botón que fuerza getIdToken(true); si se quita, la
         verificación parecerá que no funciona.

         El muro está solo en la escritura: leer la cuenta (get) sigue
         permitido sin confirmar, para que el usuario vea su pantalla y el
         aviso en vez de un error suelto. */
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.auth.token.email_verified == true
                            && request.resource.data.keys().hasOnly(['pizarras'])
                            && request.resource.data.pizarras is list
                            && request.resource.data.pizarras.size() <= 3;
    }

    /* ===== La pizarra ===== */
    match /pizarras/{boardId} {
      // "read" concede get Y list, y list no necesita ningún ID: basta con pedir
      // la colección para descargarse todas las pizarras sin saber ninguna clave.
      // Con solo get hay que conocer el hash exacto, que es lo que la clave protege.
      allow get: if autorizado(resource);
      allow list: if false;

      // request.resource es null en un delete, así que esta condición también
      // impide borrar la pizarra entera: la app nunca lo hace y nadie debería.
      allow write: if request.resource != null
                   && request.resource.data.keys().hasOnly(['data', 'writer', 'updatedAt', 'owner', 'miembros'])
                   && request.resource.data.data is string
                   // Suelo: la app guarda con set() —ahora con merge, para no
                   // barrer `owner` en cada guardado— así que una escritura de
                   // un carácter reemplaza la pizarra entera y la deja vacía.
                   // normalizeState() siembra siempre rivales, entrenamientos,
                   // tácticas y live, de modo que el estado más pequeño que
                   // puede generar la app ronda los 2.900 caracteres: 500 corta
                   // el borrado por sobrescritura sin acercarse a nada real.
                   && request.resource.data.data.size() > 500
                   && request.resource.data.data.size() < 950000
                   && autorizado(resource)
                   && duenioCoherente()
                   && invitadosCoherentes();

      // Heredada: o se deja como está, o se reclama para uno mismo.
      // Con dueño: el dueño no se toca nunca más.
      function duenioCoherente() {
        return heredada(resource)
               ? (duenio(request.resource) == null
                  || (request.auth != null && duenio(request.resource) == request.auth.uid))
               : duenio(request.resource) == duenio(resource);
      }

      // La lista de invitados solo la cambia el dueño. Un invitado puede
      // trabajar en la pizarra, pero no meter a nadie más ni echar al dueño.
      function invitadosCoherentes() {
        return (invitados(request.resource) == invitados(resource)
                || (request.auth != null && duenio(request.resource) == request.auth.uid))
               // Un cuerpo técnico no son veinte personas, y sin tope la lista
               // sirve de almacén: cada correo son bytes en un documento que ya
               // tiene un límite de 1 MB compartido con toda la pizarra.
               && invitados(request.resource).size() <= 10;
      }
    }

    /* ===== Eventos del partido =====
       Un documento por evento, dentro de la pizarra. Así el documento grande no
       crece sin control y dos dispositivos autorizados pueden registrar a la vez
       sin pisarse.

       Antes esto era `allow read: if true`: con la clave se bajaba el partido
       entero. Ahora manda el dueño de la pizarra padre, igual que arriba.

       Se consulta el padre con get(), que sí cuesta una lectura, pero las
       llamadas idénticas se cachean dentro de la misma petición: el lote de
       limpiarEventos() la paga una vez. Y si la pizarra padre todavía no
       existe se deja pasar, porque reemplazarEventosEnNube() sube los eventos
       ~600 ms ANTES que el documento de la pizarra: exigirlo rompería la
       restauración de una copia sobre una pizarra nueva. */
    match /pizarras/{boardId}/eventos/{eventoId} {
      allow read, delete: if autorizadoEn(boardId);
      // El tope de 30 campos deja sitio a los eventos heredados, que arrastran
      // sin limpiar los campos viejos type, playerId, min y half.
      allow create, update: if request.resource != null
                            && request.resource.data.size() < 30
                            && request.resource.data.tipo is string
                            && autorizadoEn(boardId);
    }

    /* ===== Histórico de partidos jugados =====
       Cuelga de la pizarra, no de la raíz: en la raíz una colección "partidos"
       sería común a TODAS las claves y cualquiera vería el histórico de los
       demás.
       La cabecera es lo único que lee el listado (fecha, equipos y resultado);
       el informe entero vive en el subdocumento de abajo y solo se descarga al
       abrir un partido concreto. */
    match /pizarras/{boardId}/partidos/{partidoId} {
      allow read, delete: if autorizadoEn(boardId);
      // Los topes de texto son deliberadamente holgados (300 frente a los ~20
      // caracteres de un nombre real). La app no impone ningún maxlength en sus
      // inputs, y si estas reglas rechazasen el archivado se PERDERÍA el
      // partido: "Iniciar partido" borra los eventos de todas formas. El límite
      // está para frenar abuso, no para corregir al entrenador.
      // Ojo al corregir una ficha: guardarEdicion() manda 6 campos, pero en un
      // update request.resource.data es el documento resultante completo, así
      // que ts y lugar llegan aquí con el valor ya guardado y se validan igual.
      allow create, update: if request.resource != null
                            && request.resource.data.size() < 20
                            && request.resource.data.fecha is string
                            && request.resource.data.fecha.size() <= 10
                            && request.resource.data.local is string
                            && request.resource.data.local.size() <= 300
                            && request.resource.data.visitante is string
                            && request.resource.data.visitante.size() <= 300
                            && request.resource.data.competicion is string
                            && request.resource.data.competicion.size() <= 300
                            && request.resource.data.lugar is string
                            && request.resource.data.lugar.size() <= 300
                            && autorizadoEn(boardId);

      // El id siempre es literalmente "informe": archivar(), borrar() y abrir()
      // no usan ningún otro. Fijarlo impide colgar documentos arbitrarios de un
      // partido para usar la pizarra de almacén ajeno.
      match /detalle/{docId} {
        allow read, delete: if autorizadoEn(boardId);
        allow create, update: if docId == 'informe'
                              && request.resource != null
                              && request.resource.data.keys().hasOnly(['datos'])
                              && request.resource.data.datos is string
                              && request.resource.data.datos.size() < 900000
                              && autorizadoEn(boardId);
      }
    }
  }
}
